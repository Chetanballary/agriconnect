# Agri Direct — Environment Variables

# Supabase (pre-populated in Bolt environment)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# For self-hosted NextAuth (if using Auth.js instead of Supabase Auth)
NEXTAUTH_SECRET=your-nextauth-secret
NEXTAUTH_URL=http://localhost:3000

# MongoDB Atlas (alternative DB option, not used in this build)
DATABASE_URL=mongodb+srv://user:pass@cluster.mongodb.net/agridirect
